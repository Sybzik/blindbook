# --- secrets: never commit keys, seeds or wallet databases ---
.env
.env.*
!.env.example
*.key
*.pem
*seed*
*.mnemonic
secrets/
keys/
# the design system copy in the app (KeyButton), not key material
!web/src/ds/components/keys/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
wallet-data/

# --- rust ---
target/
**/*.rs.bk

# --- node / web ---
node_modules/
dist/
.vite/
.turbo/
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# --- video files ---
*.mp4
*.mov

# --- os / editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json


# Built from crates/blindbook-engine-wasm by web/scripts/wasm.mjs
web/src/wasm/

# --- deployment: filled-in configuration, keys, data and build output stay on the servers ---
deploy/*/*.env
deploy/*/data/
deploy/*/config/
deploy/api/onion-site/
deploy/web/site/
deploy/*/data-main/
deploy/*/config-main/
deploy/*/secrets-main/
