# VPS-1 configuration. Copy to api.env and fill in; api.env never goes into git.

# The API's public host name and where Caddy sends it (Caddy gets the TLS certificate). With the
# mainnet stack too (compose.mainnet.yml), add its host: "api.example.org=api:8080 main.example.org=api-main:8080".
BB_SITES=api.example.org=api:8080

# The network: testnet (the judge playground) or mainnet (the micro-stakes proof).
BB_NETWORK=testnet
BB_ZCASH_NET=test
# lightwalletd / Zaino: zecrocks (testnet.zec.rocks), zecrocks-main (zec.rocks) or host:port.
BB_LWD=zecrocks

# M, the mint master public key, printed by `blindbook-signer keygen` (the same M goes into the app build).
BB_M=
# A long random token the signer presents on /v1/signer (the same in signer.env).
BB_SIGNER_TOKEN=

# The reserve wallet's birthday height, printed by `blindbook-signer init`.
BB_RESERVE_BIRTHDAY=

# CREDIT per judge code: 5000 units = 0.05 TAZ on testnet. Must match signer.env.
BB_VOUCHER_UNITS=5000

# Proof-of-work bits (defaults 16 and 20).
# BB_POW_LIGHT=16
# BB_POW_HEAVY=20

RUST_LOG=info
