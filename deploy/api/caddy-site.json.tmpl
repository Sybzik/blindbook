{
  "match": [
    {
      "host": [
        "__HOST__"
      ]
    }
  ],
  "handle": [
    {
      "handler": "subroute",
      "routes": [
        {
          "handle": [
            {
              "handler": "headers",
              "response": {
                "set": {
                  "Strict-Transport-Security": [
                    "max-age=31536000"
                  ],
                  "X-Content-Type-Options": [
                    "nosniff"
                  ],
                  "Referrer-Policy": [
                    "no-referrer"
                  ]
                },
                "delete": [
                  "Server"
                ]
              }
            }
          ]
        },
        {
          "match": [
            {
              "method": [
                "POST"
              ]
            }
          ],
          "handle": [
            {
              "handler": "headers",
              "response": {
                "set": {
                  "Connection": [
                    "close"
                  ]
                }
              }
            }
          ]
        },
        {
          "match": [
            {
              "path": [
                "/v1/*"
              ]
            }
          ],
          "handle": [
            {
              "handler": "reverse_proxy",
              "upstreams": [
                {
                  "dial": "__UPSTREAM__"
                }
              ],
              "headers": {
                "request": {
                  "delete": [
                    "X-Forwarded-For",
                    "X-Real-Ip",
                    "Forwarded",
                    "Via"
                  ]
                }
              }
            }
          ],
          "terminal": true
        },
        {
          "handle": [
            {
              "handler": "static_response",
              "status_code": 404
            }
          ]
        }
      ]
    }
  ],
  "terminal": true
}
