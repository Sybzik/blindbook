{
  "admin": {
    "disabled": true
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.log",
          "http.handlers",
          "http.stdlib",
          "tls.handshake"
        ]
      }
    }
  },
  "apps": {
    "tls": {
      "session_tickets": {
        "disabled": true
      }
    },
    "http": {
      "servers": {
        "public": {
          "listen": [
            ":443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "read_header_timeout": "30s",
          "idle_timeout": "2m",
          "routes": [
            __ROUTES__
          ]
        },
        "onion": {
          "listen": [
            ":8081"
          ],
          "read_header_timeout": "30s",
          "idle_timeout": "2m",
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "set": {
                      "X-Content-Type-Options": [
                        "nosniff"
                      ],
                      "Referrer-Policy": [
                        "no-referrer"
                      ],
                      "X-Frame-Options": [
                        "SAMEORIGIN"
                      ],
                      "Content-Security-Policy": [
                        "frame-ancestors 'self'"
                      ],
                      "Permissions-Policy": [
                        "camera=(self), microphone=(), geolocation=(), interest-cohort=()"
                      ],
                      "Cross-Origin-Opener-Policy": [
                        "same-origin"
                      ]
                    },
                    "delete": [
                      "Server",
                      "Via"
                    ]
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "path": [
                    "/assets/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "set": {
                      "Cache-Control": [
                        "public, max-age=31536000, immutable"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "method": [
                    "POST"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "set": {
                      "Connection": [
                        "close"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "path": [
                    "/v1/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "api:8080"
                    }
                  ],
                  "headers": {
                    "request": {
                      "delete": [
                        "X-Forwarded-For",
                        "X-Real-Ip",
                        "Forwarded",
                        "Via"
                      ]
                    }
                  }
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "file_server",
                  "root": "/srv/onion"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
