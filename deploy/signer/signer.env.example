# VPS-2 configuration. Copy to signer.env and fill in; signer.env never goes into git.

# The API's signer endpoint (wss:// on a real host).
BB_API_URL=wss://api.example.org/v1/signer
# The same token as BB_SIGNER_TOKEN in api.env.
BB_SIGNER_TOKEN=

BB_NETWORK=testnet
BB_ZCASH_NET=test
BB_LWD=zecrocks

# CREDIT per judge code: must match api.env.
BB_VOUCHER_UNITS=5000

# Blocks between anchors and between sweeps (default 48, about an hour).
# BB_ANCHOR_EVERY=48
# BB_SWEEP_EVERY=48

# Polygon RPCs the signer reads results from itself (default: the two public ones).
# BB_POLYGON_RPCS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org

RUST_LOG=info
